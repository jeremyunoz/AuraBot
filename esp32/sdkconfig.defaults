# Choice overrides first (must select desired option, not set others to n)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PICOTTS_LANGUAGE_EN_US=y
CONFIG_PICOTTS_RESOURCE_MODE_PARTITION=y

# Custom partition table: larger app (3M) for PicoTTS + TA/SG partitions
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_MAXIMUM_RETRY=5

# Voice session (online TTS): disabled by default; set VOICE_SESSION_ENABLE=y and VOICE_WS_URI to use
# CONFIG_VOICE_SESSION_ENABLE=n
# CONFIG_VOICE_WS_URI="ws://pi5.local:8765/voice"
# CONFIG_VOICE_WS_NETWORK_TIMEOUT_MS=45000
